import Mathlib

/-!
# Inductively defined propositions


    There are two ways to say "the set generated by some rules".

    *Top-down*: `x ∈ ⟨S⟩` iff `x` lies in every subgroup containing `S`
    (membership is a ∀-statement; minimality is free).

    *Bottom-up*: `x ∈ ⟨S⟩` iff `x` is a word in `S ∪ S⁻¹`, i.e. there is a
    finite derivation of `x` (membership is an ∃-statement; closure is free).

    They agree — and proving that *is* induction.
    
    Lean's `inductive` takes the bottom-up view as primitive: a proof of
    membership *is* a derivation tree (our running example will be the
    even numbers).  
    
    Constructors = closure, recursor = minimality, and the payoff is
    *inversion* (`cases`: "which rule was applied last?"), which the
    top-down definition only gives you as a lemma.

-/

/-! ## 1. A first example: the even numbers -/

/-- `Ev n` : "`n` is even", given by two rules:

```
  ─────────          Ev n
   Ev 0          ────────────
                  Ev (n + 2)
```
-/
inductive Ev : ℕ → Prop where
  | zero : Ev 0
  | step (n : ℕ) : Ev n → Ev (n + 2)

/-- A proof of `Ev 4` is literally a derivation tree. -/
example : Ev 4 := Ev.step 2 (Ev.step 0 Ev.zero)

/-- The same thing, built backwards with tactics. -/
example : Ev 4 := by
  apply Ev.step
  apply Ev.step
  exact Ev.zero

/- Lean can search for the derivation itself. -/

example : Ev 0 := by constructor

example : Ev 2 := by 
  constructor
  constructor
  
example : Ev 124 := by repeat constructor


/-! ### The recursor — compare with last weeks discussion

Read the output of the `#check` below as:

"any property `motive` that holds at `0`, and is preserved by the
step rule, holds for every `n` with `Ev n`."  That is exactly the
statement that `{n | Ev n}` is the *smallest* set closed under the rules.
-/

#check @Ev.rec

-- ⊢ ∀ {motive : (a : ℕ) → Ev a → Prop},
--     motive 0 Ev.zero 
--     → (∀ (n : ℕ) (a : Ev n), motive n a → motive (n + 2) ⋯) 
--     → ∀ {a : ℕ} (t : Ev a), motive a t

/-- Minimality is literally the recursor, with motive `fun m _ => m ∈ S`. -/
theorem Ev.minimal (S : Set ℕ) (h0 : 0 ∈ S) (hstep : ∀ n, n ∈ S → n + 2 ∈ S) :
    ∀ n, Ev n → n ∈ S :=
  fun _ h => Ev.rec (motive := fun m _ => m ∈ S) h0 (fun k _ ih => hstep k ih) h

/-- So the bottom-up and top-down definitions agree:
`{n | Ev n}` is the intersection of all sets closed under the rules. -/
theorem Ev.eq_sInter :
    {n | Ev n} = ⋂₀ {S : Set ℕ | 0 ∈ S ∧ ∀ n, n ∈ S → n + 2 ∈ S} := by
  ext n
  constructor
  · intro h
    rw [Set.mem_sInter]
    rintro S ⟨h0, hs⟩
    exact Ev.minimal S h0 hs n h
  · intro h
    exact Set.mem_sInter.mp h {m | Ev m}
      (show 0 ∈ {m | Ev m} ∧ ∀ k, k ∈ {m | Ev m} → k + 2 ∈ {m | Ev m} from
        ⟨Ev.zero, fun k hk => Ev.step k hk⟩)

-- the "workhorse" of this proof was `Set.mem_sInter`

#check Set.mem_sInter

-- Set.mem_sInter.{u} {α : Type u} {x : α} {S : Set (Set α)} : x ∈ ⋂₀ S ↔ ∀ t ∈ S, x ∈ t

/-! ## 2. Inversion

If we have `h : Ev n`, then `h` was built by one of the two constructors for `Ev`.

`cases h` splits into those possibilities — and *discards* the ones whose
indices can't match.  

Since the constructors for `ℕ` are injective and disjoint, lean "knows" that
`1 ≠ 0` and `1 ≠ m + 2`?  

-/

theorem not_ev_one : ¬ Ev 1 := by
  intro h
  cases h        -- no cases survive!

theorem not_ev_three : ¬ Ev 3 := by
  intro h
  cases h with
  | step _ h' => cases h'

/-- Inversion of the step rule. -/
theorem Ev.inv {n : ℕ} (h : Ev (n + 2)) : Ev n := by
  cases h with
  | step _ h' => exact h'

/-- Packaged as an `iff` and tagged `@[simp]`, inversion becomes automatic
(this is the form Mathlib usually provides). -/
@[simp] theorem ev_add_two_iff {n : ℕ} : Ev (n + 2) ↔ Ev n :=
  ⟨Ev.inv, Ev.step n⟩



/-! ## 3. Rule induction

Point to make: try proving `Ev n → ∃ k, n = 2 * k` by induction on `n`.
The inductive hypothesis for `n` is useless at `n + 1` (which is odd
whenever `n` is even).  Inducting on the *evidence* `h` instead
gives exactly the right cases.
-/

theorem Ev.exists_double {n : ℕ} (h : Ev n) : ∃ k, n = 2 * k := by
  induction h with
  | zero => exact ⟨0, rfl⟩
  | step n _ ih =>
    obtain ⟨k, rfl⟩ := ih
    exact ⟨k + 1, by ring⟩

/-- The converse is an ordinary induction on `k` (on the data, not a proof). -/
theorem ev_double (k : ℕ) : Ev (2 * k) := by
  induction k with
  | zero => exact Ev.zero
  | succ k ih =>
    have e : 2 * (k + 1) = 2 * k + 2 := by ring
    rw [e]
    exact Ev.step _ ih

theorem ev_iff (n : ℕ) : Ev n ↔ ∃ k, n = 2 * k := by
  constructor
  · exact Ev.exists_double
  · rintro ⟨k, rfl⟩
    exact ev_double k

/- Now let's prove that one more than an even number is not even -/

/-- Version 1: reuse the inversion lemma. -/
theorem Ev.add_one_not_even {n : ℕ} (h : Ev n) : ¬ Ev (n + 1) := by
  induction h with
  | zero => intro h'; cases h'
  | step n _ ih =>
    intro h'                          -- h' : Ev (n + 2 + 1)
    have e : n + 2 + 1 = (n + 1) + 2 := by omega
    rw [e] at h'
    exact ih h'.inv

/-- Version 2: invert inline with `cases`. -/
example {n : ℕ} (h : Ev n) : ¬ Ev (n + 1) := by
  induction h with
  | zero => intro h'; cases h'
  | step n _ ih =>
    intro h'
    cases h' with
    | step _ h'' => exact ih h''

/-- Version 3: let `simp` do the inversion. -/
example {n : ℕ} (h : Ev n) : ¬ Ev (n + 1) := by
  induction h with
  | zero => intro h'; cases h'
  | step n _ ih =>
    have e : n + 2 + 1 = (n + 1) + 2 := by omega
    rw [e, ev_add_two_iff]
    exact ih




/-! ## 5. Coda: `Bool` vs `Prop`

A *program* that decides evenness, versus the *proposition* `Ev`. -/

def isEven : ℕ → Bool
  | 0 => true
  | 1 => false
  | n + 2 => isEven n

#eval isEven 10      -- true
#eval isEven 2027    -- false

theorem ev_of_isEven : ∀ n, isEven n = true → Ev n
  | 0, _ => Ev.zero
  | 1, h => by simp [isEven] at h
  | n + 2, h => Ev.step n (ev_of_isEven n h)

theorem isEven_of_ev {n : ℕ} (h : Ev n) : isEven n = true := by
  induction h with
  | zero => rfl
  | step n _ ih => simpa [isEven] using ih

/-- Packaging the agreement as a `Decidable` instance lets `decide` prove
statements about `Ev` by *running the program*. -/
instance : DecidablePred Ev := fun n =>
  decidable_of_iff (isEven n = true) ⟨ev_of_isEven n, isEven_of_ev⟩

example : Ev 100 := by decide
example : ¬ Ev 101 := by decide

/-! ### You can't get data out of a proof

Lean rejects the following: a proof of `Ev n` lives in `Prop`, and
(since `Ev` has two constructors) its recursor only eliminates into `Prop`.
Proofs carry no computational content you can branch on.

```
def half : (n : ℕ) → Ev n → ℕ
  | _, .zero     => 0
  | _, .step n h => half n h + 1
```

(Of course `n / 2` is perfectly computable — just not *from the proof*.)
-/

-- here is a way to do it properly

def half : ℕ → ℕ
  | 0 => 0
  | 1 => 0
  | n + 2 => half n + 1

#eval half 10   -- 5
#eval half 11   -- also 5

theorem two_mul_half {n : ℕ} (h : Ev n) : 2 * half n = n := by
  induction h with
  | zero => rfl
  | step n _ ih => simp only [half]; omega
  
-- another way

def half' : (n : ℕ) → Ev n → ℕ
  | 0, _ => 0
  | 1, h => absurd h not_ev_one          -- impossible case
  | n + 2, h => half' n h.inv + 1

#eval half' 10 (by decide)   -- 5, using the DecidablePred instance
