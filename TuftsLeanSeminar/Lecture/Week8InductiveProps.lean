/-! ## 4. Inductive propositions in Mathlib

These are everywhere; you've been using some without knowing it.
-/

-- `≤` on ℕ is an inductive proposition!
#print Nat.le
-- inductive Nat.le (n : ℕ) : ℕ → Prop
--   | refl : n.le n
--   | step : ∀ {m}, n.le m → n.le (m + 1)

-- The reflexive–transitive closure of a relation
#print Relation.ReflTransGen
-- The equivalence relation generated by a relation
#print EqvGen
-- Mathlib *defines* `Subgroup.closure` top-down (as an `sInf`), and then
-- *proves* the bottom-up induction principle as a theorem:
#check @Subgroup.closure_induction

/-! ### Building our own reflexive–transitive closure

(Software Foundations calls this `multi`; it is how one says
"program `a` evaluates to `b` in some number of steps".)
-/

inductive Star {α : Type*} (r : α → α → Prop) : α → α → Prop where
  | refl (a : α) : Star r a a
  | step {a b c : α} : r a b → Star r b c → Star r a c

/-- Transitivity is *not* a rule; it is a theorem, proved by rule induction.
Note that `induction` automatically generalizes `hbc`, since it mentions `b`. -/
theorem Star.trans {α : Type*} {r : α → α → Prop} {a b c : α}
    (hab : Star r a b) (hbc : Star r b c) : Star r a c := by
  induction hab with
  | refl _ => exact hbc
  | step hr _ ih => exact Star.step hr (ih hbc)

/-- A single step is a `Star`. -/
theorem Star.single {α : Type*} {r : α → α → Prop} {a b : α} (h : r a b) :
    Star r a b :=
  Star.step h (Star.refl b)

/-- Exercise: our `Star` agrees with Mathlib's `ReflTransGen`.
(Mathlib's version adds new steps at the *end* (`tail`), ours at the *front*.) -/
theorem star_iff_reflTransGen' {α : Type*} (r : α → α → Prop) (a b : α) :
    Star r a b ↔ Relation.ReflTransGen r a b := by
  sorry

/-! ## 5. Coda: `Bool` vs `Prop`

A *program* that decides evenness, versus the *proposition* `Ev`. -/

def isEven : ℕ → Bool
  | 0 => true
  | 1 => false
  | n + 2 => isEven n

#eval isEven 10      -- true
#eval isEven 2027    -- false

theorem ev_of_isEven : ∀ n, isEven n = true → Ev n
  | 0, _ => Ev.zero
  | 1, h => by simp [isEven] at h
  | n + 2, h => Ev.step n (ev_of_isEven n h)

theorem isEven_of_ev {n : ℕ} (h : Ev n) : isEven n = true := by
  induction h with
  | zero => rfl
  | step n _ ih => simpa [isEven] using ih

/-- Packaging the agreement as a `Decidable` instance lets `decide` prove
statements about `Ev` by *running the program*. -/
instance : DecidablePred Ev := fun n =>
  decidable_of_iff (isEven n = true) ⟨ev_of_isEven n, isEven_of_ev⟩

example : Ev 100 := by decide
example : ¬ Ev 101 := by decide

/-! ### You can't get data out of a proof

Lean rejects the following: a proof of `Ev n` lives in `Prop`, and
(since `Ev` has two constructors) its recursor only eliminates into `Prop`.
Proofs carry no computational content you can branch on.

```
def half : (n : ℕ) → Ev n → ℕ
  | _, .zero     => 0
  | _, .step n h => half n h + 1
```

(Of course `n / 2` is perfectly computable — just not *from the proof*.)
-/

end Seminar

/-! ## Solutions -/

namespace Seminar.Solutions

open Seminar

theorem Ev.add {m n : ℕ} (hm : Ev m) (hn : Ev n) : Ev (m + n) := by
  induction hm with
  | zero => simpa using hn
  | step m _ ih =>
    have e : m + 2 + n = (m + n) + 2 := by omega
    rw [e]
    exact Ev.step _ ih

theorem not_ev_odd (k : ℕ) : ¬ Ev (2 * k + 1) := by
  intro h
  obtain ⟨j, hj⟩ := h.exists_double
  omega

theorem star_iff_reflTransGen {α : Type*} (r : α → α → Prop) (a b : α) :
    Star r a b ↔ Relation.ReflTransGen r a b := by
  constructor
  · intro h
    induction h with
    | refl _ => exact Relation.ReflTransGen.refl
    | step hr _ ih => exact Relation.ReflTransGen.head hr ih
  · intro h
    induction h with
    | refl => exact Star.refl a
    | tail _ hbc ih => exact Star.trans ih (Star.single hbc)

end Seminar.Solutions
