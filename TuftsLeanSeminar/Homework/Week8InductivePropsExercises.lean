/-! ## Solutions -/

namespace Exercises.Solutions

open Exercises

theorem Ev.add {m n : ℕ} (hm : Ev m) (hn : Ev n) : Ev (m + n) := by
  induction hm with
  | zero => simpa using hn
  | step m _ ih =>
    have e : m + 2 + n = (m + n) + 2 := by omega
    rw [e]
    exact Ev.step _ ih

theorem not_ev_odd (k : ℕ) : ¬ Ev (2 * k + 1) := by
  intro h
  obtain ⟨j, hj⟩ := h.exists_double
  omega

theorem star_iff_reflTransGen {α : Type*} (r : α → α → Prop) (a b : α) :
    Star r a b ↔ Relation.ReflTransGen r a b := by
  constructor
  · intro h
    induction h with
    | refl _ => exact Relation.ReflTransGen.refl
    | step hr _ ih => exact Relation.ReflTransGen.head hr ih
  · intro h
    induction h with
    | refl => exact Star.refl a
    | tail _ hbc ih => exact Star.trans ih (Star.single hbc)

end Seminar.Solutions
