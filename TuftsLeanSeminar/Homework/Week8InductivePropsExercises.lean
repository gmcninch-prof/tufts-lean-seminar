/-! ## 4. Inductive propositions in Mathlib

These are everywhere; you've been using some without knowing it.
-/

-- `≤` on ℕ is an inductive proposition!
#print Nat.le
-- inductive Nat.le (n : ℕ) : ℕ → Prop
--   | refl : n.le n
--   | step : ∀ {m}, n.le m → n.le (m + 1)

-- The reflexive–transitive closure of a relation
#print Relation.ReflTransGen
-- The equivalence relation generated by a relation
#print Relation.EqvGen
-- Mathlib *defines* `Subgroup.closure` top-down (as an `sInf`), and then
-- *proves* the bottom-up induction principle as a theorem:
#check @Subgroup.closure_induction

/-! ### Building our own reflexive–transitive closure

(Software Foundations calls this `multi`; it is how one says
"program `a` evaluates to `b` in some number of steps".)
-/

inductive Star {α : Type*} (r : α → α → Prop) : α → α → Prop where
  | refl (a : α) : Star r a a
  | step {a b c : α} : r a b → Star r b c → Star r a c

/-- Transitivity is *not* a rule; it is a theorem, proved by rule induction.
Note that `induction` automatically generalizes `hbc`, since it mentions `b`. -/
theorem Star.trans {α : Type*} {r : α → α → Prop} {a b c : α}
    (hab : Star r a b) (hbc : Star r b c) : Star r a c := by
  induction hab with
  | refl _ => exact hbc
  | step hr _ ih => exact Star.step hr (ih hbc)

/-- A single step is a `Star`. -/
theorem Star.single {α : Type*} {r : α → α → Prop} {a b : α} (h : r a b) :
    Star r a b :=
  Star.step h (Star.refl b)

/-- Exercise: our `Star` agrees with Mathlib's `ReflTransGen`.
(Mathlib's version adds new steps at the *end* (`tail`), ours at the *front*.) -/
theorem star_iff_reflTransGen' {α : Type*} (r : α → α → Prop) (a b : α) :
    Star r a b ↔ Relation.ReflTransGen r a b := by
  sorry


